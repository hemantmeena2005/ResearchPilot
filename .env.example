# ResearchPilot Environment Configuration Example
# Copy this file to .env and configure your variables

# Groq LLM API Configuration
# Obtain your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Application and Storage
DATABASE_URL=sqlite+aiosqlite:///./data/researchpilot.db
UPLOAD_DIR=./data/uploads
INDEX_DIR=./data/indexes
MAX_UPLOAD_MB=25

# Local Machine Learning Models
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
DEVICE=cpu

# Retrieval & RAG Parameters
TOP_K=8
BM25_TOP_K=8
USE_RERANKER=true
USE_HYBRID=true
CONFIDENCE_THRESHOLD=0.35

# Server & Logging
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
